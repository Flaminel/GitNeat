{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitNeat",
  "version": "0.1.0",
  "identifier": "dev.gitneat.app",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev:web", "cwd": "../.." },
    "beforeBuildCommand": { "script": "npm run build:web", "cwd": "../.." }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
