{
  "name": "gitneat",
  "productName": "GitNeat",
  "version": "0.1.0",
  "description": "Open source Git GUI with a tabbed, graph-first layout",
  "license": "GPL-3.0-only",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 ELECTRON_RUN_AS_NODE= electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "npm run build && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.gitneat.app",
    "productName": "GitNeat",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
